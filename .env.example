# 공공데이터포털에서 발급받은 인증키. (필수)
#
# Encoding / Decoding 두 종류가 나오는데 어느 쪽을 넣어도 됩니다 —
# seoul_api.build_query 가 이중 인코딩과 `+` 문제를 알아서 처리합니다.
# 키가 통하는지 먼저 확인: python -m scripts.smoke_live 4312
SEOUL_BUS_SERVICE_KEY=

# 목업 모드. 이건 테스트·데모용이지 운영 모드가 아닙니다.
# 비워두면 실데이터로 동작하고, 키가 없으면 조용히 가짜 데이터를 보여주는 대신
# 시작 시점에 멈춥니다. 화면만 보려면 1 로 켜세요.
USE_MOCK=

# 실시간 응답 캐시 TTL(초). 새로고침 연타로 외부 API를 때리지 않게 막습니다.
LIVE_TTL_SEC=20

# 외부 API 타임아웃(초).
API_TIMEOUT_SEC=4.0

# 사전 적재할 노선번호 (scripts/preload.py)
PRELOAD_ROUTES=4312,402,강남06,160


# 실시간 캐시에 담아둘 항목 수 상한 (LRU)
LIVE_CACHE_MAX=500

# 수집 배치 상한 — 없으면 거대한 본문 하나로 메모리를 밀어 올릴 수 있습니다.
MAX_COLLECT_BYTES=131072
MAX_COLLECT_EVENTS=100

# write_key:service 매핑. 서버는 본문의 service 값이 아니라 이 표로 발신자를 가립니다.
WRITE_KEYS=wk_seoul_bus_demo:seoul-bus-web
